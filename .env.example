# Database
DATABASE_URL="postgresql://user:password@localhost:5432/performa_ai?schema=public"

# API
PORT=3000
HOST=0.0.0.0

# JWT (kept for backward compatibility with existing sessions)
JWT_SECRET="change-me-in-production"

# Better Auth
BETTER_AUTH_SECRET="random-secret-for-signing-change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (SSO)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (SSO)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OpenRouter (Replaces Together AI)
OPENROUTER_API_KEY=""
OPENROUTER_APP_TITLE="Renovix AI"
OPENROUTER_APP_URL="https://chat.renovix.id"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
# Optional: comma-separated fallback list (first available model will be used)
# OPENROUTER_EMBEDDING_MODELS="openai/text-embedding-3-small,openai/text-embedding-3-large"
# Keep this aligned with existing knowledge chunk vector dimension (current data uses 1024)
OPENROUTER_EMBEDDING_DIMENSIONS="1024"

# Stripe (Disabled — will re-enable later)
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Dashboard
DASHBOARD_URL="http://localhost:4200"

# S3
S3_BUCKET=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_CDN_DOMAIN=""

# Docker Production (used by docker-compose.prod.yml)
POSTGRES_USER="performa"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="performa_ai"
REDIS_PASSWORD="change-me"
API_URL="http://localhost:3000"

# Email (Amazon SES SMTP)
EMAIL_FROM="no-reply@notify.performa.ai"
SMTP_HOST="email-smtp.ap-southeast-1.amazonaws.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=""
SMTP_PASSWORD=""
APP_BASE_URL="https://chat.performa.ai"

# MCP Integrations
API_PUBLIC_URL="http://localhost:3000"
CHAT_APP_URL="http://localhost:4201"
MCP_ENCRYPTION_KEY=""

