# Database
DATABASE_URL="postgresql://user:password@localhost:5432/performa_ai?schema=public"

# API
PORT=3000
HOST=0.0.0.0

# JWT (kept for backward compatibility with existing sessions)
JWT_SECRET="change-me-in-production"
# Cookie domain for the Better Auth session and the email-login jwt cookie (RX-68).
# Optional: unset = host-only locally (cookies ignore ports); in production it is
# derived from API_PUBLIC_URL (api.renovix.id → .renovix.id). Set it to override.
COOKIE_DOMAIN=

# Back-office sign-in (RX-94). Required, no fallback: the API does not start without them.
# Signing key of the back-office access token, at least 32 characters, never the same as JWT_SECRET:
#   openssl rand -base64 48
ADMIN_JWT_SECRET=
# AES-256-GCM key for the admins' TOTP secrets at rest, 32 bytes base64-encoded:
#   openssl rand -base64 32
ADMIN_TOTP_ENCRYPTION_KEY=
# Security values default to the decided ones (12-character passwords, 5 attempts then 15 minutes,
# 15-minute access token, 30 minutes idle, 12 hours absolute, 5-minute re-authentication window);
# overrides: ADMIN_AUTH_* in apps/api/src/app/admin-auth/utils/parse-admin-auth-config.ts.

# Better Auth
BETTER_AUTH_SECRET="random-secret-for-signing-change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Free-tier (anonymous) caps
# Required: HMAC key for client IPs, so raw IPs are never stored
IP_HASH_SECRET="random-secret-change-me"
# Name of the header that carries the client IP. Set it only when a trusted proxy
# in front of the API sets this header and overwrites any client-sent copy, and
# the API is reachable only through that proxy. Leave unset locally: the socket
# address is used. X-Forwarded-For is never used.
# CLIENT_IP_HEADER="x-client-ip"
# Daily caps (Asia/Jakarta day); defaults 60 per IP, 2000 in total
# ANON_DAILY_IP_CAP=60
# ANON_DAILY_GLOBAL_CAP=2000

# Google OAuth (SSO)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (SSO)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_APP_TITLE="Renovix AI"
OPENROUTER_APP_URL="https://chat.renovix.id"

# Stripe (Disabled — will re-enable later)
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Dashboard
DASHBOARD_URL="http://localhost:4200"

# S3
S3_BUCKET=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_CDN_DOMAIN=""

# Docker Production (used by docker-compose.prod.yml)
POSTGRES_USER="performa"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="performa_ai"
REDIS_PASSWORD="change-me"
API_URL="http://localhost:3000"

# Email (Amazon SES SMTP)
EMAIL_FROM="no-reply@notify.performa.ai"
SMTP_HOST="email-smtp.ap-southeast-1.amazonaws.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=""
SMTP_PASSWORD=""
APP_BASE_URL="https://chat.performa.ai"

# MCP Integrations
API_PUBLIC_URL="http://localhost:3000"
CHAT_APP_URL="http://localhost:4201"
MCP_ENCRYPTION_KEY=""

