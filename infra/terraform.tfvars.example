# Copy this to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git

project_id  = "your-gcp-project-id"
region      = "asia-southeast2"
environment = "production"
domain      = "renovix.id"
db_tier     = "db-f1-micro"

# The back-office app's own origin (RX-156): /admin routes refuse every other Origin
admin_origin = "https://admin.renovix.id"

# These are sensitive — set via environment or prompt
# db_password        = "generate-a-strong-password"
# jwt_secret         = "generate-a-strong-secret"
# better_auth_secret = "generate-a-strong-secret"
# mcp_encryption_key = "base64-encoded-32-byte-key"

# OAuth consent screen
oauth_support_email = "support@renovix.id"
