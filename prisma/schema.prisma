generator client {
  provider        = "prisma-client"
  output          = "../apps/api/src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  emailVerified Boolean        @default(false) @map("email_verified")
  password      String?        // Nullable — SSO users won't have a password

  // Profile fields
  name          String?
  firstName     String?        @map("first_name")
  lastName      String?        @map("last_name")
  avatar        String?        // URL to profile picture
  phone         String?
  company       String?
  jobTitle      String?        @map("job_title")
  timezone      String?        @default("UTC")
  locale        String?        @default("en")

  // Auth
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz()
  lastLoginIp   String?        @map("last_login_ip")

  // Status
  status        String         @default("active") // "active" | "suspended" | "deleted"

  // Better Auth relations
  accounts      Account[]
  sessions      Session[]

  // Existing relations
  createdAt     DateTime       @default(now()) @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @db.Timestamptz()
  usageLogs     UsageLog[]
  conversations Conversation[]
  knowledgeBases KnowledgeBase[]
  portalSessions PortalSession[]
  memories      UserMemory[]
  agents        Agent[]
  agentRuns     AgentRun[]
  subscription  UserSubscription?
  codeRedemptions CodeRedemption[]
  channels      Channel[]
  ownedWorkspaces    Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  workspaceInvitesSent WorkspaceInvite[] @relation("InviteSender")
  mcpCredentials UserMcpCredential[]
  mcpOAuthStates McpOAuthState[]
  guardrailViolations GuardrailViolation[]
  reminders       Reminder[]
  purchaseSnapshots PurchaseSnapshot[]
  paymentOrders   PaymentOrder[]
  creditAccounts  CreditAccount[]
  apiKeys         ApiKey[]

  @@map("users")
}

/// A user's API key (RNX-18, D49, D50). The plaintext (`rnx_live_` + 76 hex characters) is shown once and never
/// stored: only its prefix (the first 12 hex characters, the lookup) and its HMAC-SHA256 under API_KEY_HASH_SECRET.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefix     String    @unique
  keyHash    String    @map("key_hash")
  name       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz()
  /// RNX-232 (D47): the model tiers this key may call, set at creation from the tiers the user's package allows.
  allowedTiers     String[] @default([]) @map("allowed_tiers")
  /// RNX-232 (D47): the most credits this key may use in an Asia/Jakarta calendar month; null: no cap.
  monthlyCreditCap Decimal? @map("monthly_credit_cap") @db.Decimal(18, 6)

  @@index([userId, createdAt])
  @@map("api_keys")
}

model UsageLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  model        String
  inputTokens  Int
  outputTokens Int
  cost         Decimal  @db.Decimal(12, 6)
  latencyMs    Int
  provider     String
  createdAt    DateTime @default(now()) @db.Timestamptz()

  @@index([userId])
  @@index([createdAt])

  @@map("usage_logs")
}

/// RX-177 (D148, D149): an upstream LLM connection, managed through /admin/providers (no seed). The key is
/// stored only encrypted (AES-256-GCM, LLM_KEY_ENCRYPTION_KEY, version in credentialKeyVersion) and never
/// returned; apiKeyHint is its last 4 characters. type cannot change after creation. A new provider is
/// inactive; activation needs a successful test since the last change of the key or the base URL (a change
/// clears lastTestedAt and lastTestResult). Soft-deleted with deletedAt; name is unique among live rows.
enum ProviderType {
  nine_router       @map("9router")
  openai_compatible
}

enum ProviderStatus {
  inactive
  active
}

model Provider {
  id                   String         @id @default(uuid())
  type                 ProviderType
  name                 String
  baseUrl              String         @map("base_url")
  apiKeyCiphertext     String         @map("api_key_ciphertext")
  apiKeyHint           String         @map("api_key_hint")
  credentialKeyVersion Int            @map("credential_key_version")
  status               ProviderStatus @default(inactive)
  lastTestedAt         DateTime?      @map("last_tested_at") @db.Timestamptz()
  /// "success", or the readable reason of the last failed test.
  lastTestResult       String?        @map("last_test_result")
  createdByAdminId     String         @map("created_by_admin_id")
  createdBy            AdminUser      @relation("ProviderCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  updatedByAdminId     String         @map("updated_by_admin_id")
  updatedBy            AdminUser      @relation("ProviderUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: Restrict)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz()
  /// RNX-162: multiplies the provider's reported cost of a call into our low cost estimate; null means 1.
  costMultiplier       Decimal?       @map("cost_multiplier") @db.Decimal(12, 6)
  /// RNX-162: the lowest our low cost estimate of one call may be, in USD; null means no floor.
  perCallFloorUsd      Decimal?       @map("per_call_floor_usd") @db.Decimal(18, 12)
  /// RNX-162: with highCaseTokenThreshold, our high cost estimate of a call above the threshold is low x this factor.
  highCaseFactor       Decimal?       @map("high_case_factor") @db.Decimal(12, 6)
  /// RNX-162: the total tokens (new + cached + output) a call must exceed for highCaseFactor to apply.
  highCaseTokenThreshold Int?         @map("high_case_token_threshold")
  models               AiModel[]
  reconciliationEntries ProviderReconciliationEntry[]

  @@unique([name], where: raw("deleted_at IS NULL"))
  @@index([createdByAdminId])
  @@index([updatedByAdminId])
  @@map("providers")
}

model AiModel {
  id               String   @id @default(uuid())
  slug             String   @unique
  modelName        String   @map("model_name")
  provider         String   @default("openrouter")
  /// RX-177: new models do not write provider_id (D149 option B, the slug is the provider's id); request-time resolution is RX-178.
  providerId       String   @default("") @map("provider_id")
  /// RX-177: the provider record this model belongs to; null on rows created before RX-177.
  providerRecordId String?  @map("provider_record_id")
  providerRecord   Provider? @relation(fields: [providerRecordId], references: [id], onDelete: Restrict)
  inputPrice       Decimal  @db.Decimal(18, 12) @map("input_price")
  outputPrice      Decimal  @db.Decimal(18, 12) @map("output_price")
  /// RX-21: the provider's cached-input price; null when the provider reports none yet.
  cachedInputPrice Decimal? @db.Decimal(18, 12) @map("cached_input_price")
  /// RX-21: when the price-refresh job last updated this row's prices.
  priceUpdatedAt   DateTime? @map("price_updated_at") @db.Timestamptz()
  maxTokens        Int      @map("max_tokens")
  maxOutputTokens  Int?     @map("max_output_tokens")
  tier             String   @default("standard")
  creditMultiplier Decimal  @default(1.0) @db.Decimal(6, 2) @map("credit_multiplier")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz()
  updatedAt        DateTime @updatedAt @db.Timestamptz()
  /// RNX-179: this model's fallback models, in order.
  fallbacks        AiModelFallback[] @relation("ModelFallbacks")
  /// RNX-179: the models that name this one as a fallback.
  fallbackFor      AiModelFallback[] @relation("FallbackModel")

  @@index([tier])
  @@index([active, tier])
  @@index([providerRecordId])
  @@map("ai_models")
}

/// RNX-179 (D58, D149): one fallback model of a model, at its 0-based position in the model's ordered list. A call
/// to the model that gets a 502 or 503 goes to the next fallback, with that model's own provider and slug. Set
/// through PATCH /admin/providers/:id/models/:modelId (fallbackModelIds); a fallback is never the model itself and
/// its tier is the model's or a lower one (checked on write; a fallback whose tier was raised later is skipped).
model AiModelFallback {
  modelId         String  @map("model_id")
  model           AiModel @relation("ModelFallbacks", fields: [modelId], references: [id], onDelete: Cascade)
  fallbackModelId String  @map("fallback_model_id")
  fallbackModel   AiModel @relation("FallbackModel", fields: [fallbackModelId], references: [id], onDelete: Cascade)
  position        Int

  @@id([modelId, position])
  @@unique([modelId, fallbackModelId])
  @@index([fallbackModelId])
  @@map("ai_model_fallbacks")
}

/// RX-21: the tier rate table, one row per tier. Each column holds the tier's rate for one
/// token kind as docs/credits.md defines it: CREDITS PER 1,000,000 TOKENS of that kind
/// (column names keep the short form). The adopted values (Standard 1/1/1, Advanced 5/6/4,
/// Premium 10/20/11, Frontier 29/29/42 for input/cached/output) come only from
/// prisma/tier-rates.seed.json (`bun run seed:tier-rates`); no rate is written in code.
model TierRate {
  tier                   String   @id @unique
  /// Credits per 1,000,000 tokens (not per token; the name keeps the short form, rename with RX-22).
  inputCreditsPerToken  Decimal  @map("input_credits_per_token") @db.Decimal(18, 12)
  /// Credits per 1,000,000 tokens (not per token; the name keeps the short form, rename with RX-22).
  cachedCreditsPerToken Decimal  @map("cached_credits_per_token") @db.Decimal(18, 12)
  /// Credits per 1,000,000 tokens (not per token; the name keeps the short form, rename with RX-22).
  outputCreditsPerToken  Decimal  @map("output_credits_per_token") @db.Decimal(18, 12)
  updatedAt             DateTime @updatedAt @db.Timestamptz()

  @@map("tier_rates")
}

model AppConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("app_configs")
}

model SystemPrompt {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  active    Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([active])
  @@map("system_prompts")
}

model PromptTemplate {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String
  content      String
  keywords     String[] // keywords used for intent matching
  active       Boolean  @default(true)
  priority     Int      @default(0)
  outputFormat String?  @map("output_format") // "pdf" | "docx" | "xlsx" | null
  createdAt    DateTime @default(now()) @db.Timestamptz()
  updatedAt    DateTime @updatedAt @db.Timestamptz()

  @@index([active])
  @@map("prompt_templates")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String?
  model     String
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  messages  Message[]

  @@index([userId])
  @@index([updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" | "assistant" | "system"
  content        String
  documentFormat String?      @map("document_format")
  documentFilename String?    @map("document_filename")
  documentKey    String?      @map("document_key")
  createdAt      DateTime     @default(now()) @db.Timestamptz()

  @@index([conversationId])
  @@map("messages")
}

model KnowledgeBase {
  id          String           @id @default(uuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])
  workspaceId String?          @map("workspace_id")
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @db.Timestamptz()
  chunks      KnowledgeChunk[]
  agentKnowledgeBases AgentKnowledgeBase[]

  @@index([userId])
  @@index([workspaceId])
  @@map("knowledge_bases")
}

model KnowledgeChunk {
  id              String        @id @default(uuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  content         String
  metadata        Json?
  embedding       Unsupported("vector(1024)")?
  tokenCount      Int
  createdAt       DateTime      @default(now()) @db.Timestamptz()

  @@index([knowledgeBaseId])
  @@map("knowledge_chunks")
}

model PortalSession {
  id            String    @id @default(uuid())
  sessionToken  String    @unique
  requestCount  Int       @default(0)
  ipAddress     String?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  lastRequestAt DateTime? @db.Timestamptz()
  lastResetAt   DateTime  @default(now()) @db.Timestamptz()
  createdAt     DateTime  @default(now()) @db.Timestamptz()

  @@index([userId])
  @@index([lastResetAt])
  @@index([ipAddress])
  @@map("portal_sessions")
}

/// Daily free-tier request counters (RX-10). bucket: "ip:<hmac hex>" or "global"; day: Asia/Jakarta date.
model AnonymousUsageCounter {
  bucket String
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([bucket, day])
  @@map("anonymous_usage_counters")
}

model UserMemory {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  type                 String    // "interest" | "preference" | "context" | "exclusion"
  content              String
  confidence           Float     @default(0.75)
  sourceMessageId      String?   @map("source_message_id")
  sourceConversationId String?   @map("source_conversation_id")
  lastConfirmedAt      DateTime  @default(now()) @db.Timestamptz()
  expiresAt            DateTime? @db.Timestamptz()
  isUserPinned         Boolean   @default(false) @map("is_user_pinned")
  status               String    @default("active") // "active" | "archived" | "deleted"
  createdAt            DateTime  @default(now()) @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @db.Timestamptz()

  @@index([userId, status])
  @@index([userId, type])
  @@map("user_memories")
}

// ─── AI Agent Portal Models ─────────────────────────────────────────────────────

model Agent {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  workspaceId     String          @map("workspace_id")
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name            String
  slug            String
  description     String?
  avatar          String?
  avatarColor     String?         @default("#6366f1") @map("avatar_color")
  systemPrompt    String          @map("system_prompt")
  model           String
  temperature     Float           @default(0.7)
  maxTokens       Int?            @map("max_tokens")
  status          String          @default("draft") // "draft" | "active" | "archived"
  isPublic        Boolean         @default(false) @map("is_public")
  tools           AgentTool[]
  integrations    AgentIntegration[]
  knowledgeBases  AgentKnowledgeBase[]
  channels        AgentChannel[]
  runs            AgentRun[]
  channelAgents   ChannelAgent[]
  guardrailViolations GuardrailViolation[]
  guardrailConfig     GuardrailConfig?
  reminders       Reminder[]
  /// RNX-118: the agents this agent may call ("Can call"), and the agents that may call it.
  calleeLinks     AgentLink[]     @relation("AgentLinkCaller")
  callerLinks     AgentLink[]     @relation("AgentLinkCallee")
  createdAt       DateTime        @default(now()) @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @db.Timestamptz()

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([isPublic])
  @@index([workspaceId, status])
  @@map("agents")
}

model AgentIntegration {
  id              String   @id @default(uuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider        String   // "jira" | "plane" | "google_calendar" | "outlook" | "notion" | "slack" | "github"
  config          Json     // { baseUrl, apiKey (encrypted), projectId, etc. }
  scopes          String[] // permitted actions
  status          String   @default("connected") // "connected" | "expired" | "revoked"
  createdAt       DateTime @default(now()) @db.Timestamptz()
  updatedAt       DateTime @updatedAt @db.Timestamptz()

  @@unique([agentId, provider])
  @@index([agentId])
  @@map("agent_integrations")
}

/// RNX-118 (PRD 10, D81): "Can call". The caller agent may call the callee agent in a run (the call_agent tool). Both
/// agents are in one workspace (checked by AgentLinkService, the only writer); an agent never links to itself (a CHECK
/// in the migration, which Prisma does not model). Deleting either agent removes the link.
model AgentLink {
  callerAgentId String   @map("caller_agent_id")
  callerAgent   Agent    @relation("AgentLinkCaller", fields: [callerAgentId], references: [id], onDelete: Cascade)
  calleeAgentId String   @map("callee_agent_id")
  calleeAgent   Agent    @relation("AgentLinkCallee", fields: [calleeAgentId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([callerAgentId, calleeAgentId])
  @@index([calleeAgentId])
  @@map("agent_links")
}

model AgentTool {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolType  String   @map("tool_type") // "web_search" | "calculator" | "api_call" | "knowledge_retrieval"
  config    Json?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([agentId])
  @@map("agent_tools")
}

model AgentKnowledgeBase {
  id              String        @id @default(uuid())
  agentId         String
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String        @map("knowledge_base_id")
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id])
  createdAt       DateTime      @default(now()) @db.Timestamptz()

  @@unique([agentId, knowledgeBaseId])
  @@map("agent_knowledge_bases")
}

model AgentChannel {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channelType String   @map("channel_type") // "web" | "whatsapp" | "api"
  config      Json?
  status      String   @default("active") // "active" | "paused" | "disconnected"
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()

  @@unique([agentId, channelType])
  @@index([channelType, status])
  @@map("agent_channels")
}

model AgentRun {
  id             String          @id @default(uuid())
  agentId        String
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// RNX-119: the person who ran it (the runner, who pays); runs, history and delete are scoped to them.
  userId         String          @map("user_id")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String          @map("session_id")
  channelType    String          @map("channel_type") // "web" | "whatsapp" | "api"
  externalUserId String?         @map("external_user_id")
  status         String          @default("active") // "active" | "completed" | "error"
  messages       AgentMessage[]
  metadata       Json?
  createdAt      DateTime        @default(now()) @db.Timestamptz()
  updatedAt      DateTime        @updatedAt @db.Timestamptz()

  @@index([agentId])
  @@index([agentId, userId])
  @@index([sessionId])
  @@index([externalUserId])
  @@map("agent_runs")
}

model AgentMessage {
  id         String   @id @default(uuid())
  runId      String   @map("run_id")
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  role       String   // "user" | "assistant" | "system" | "tool"
  content    String
  toolCalls  Json?    @map("tool_calls")
  toolResult Json?    @map("tool_result")
  tokens     Int?
  cost       Decimal? @db.Decimal(12, 6)
  createdAt  DateTime @default(now()) @db.Timestamptz()

  @@index([runId])
  @@map("agent_messages")
}

model SubscriptionPlan {
  id                String   @id @default(uuid())
  slug              String   @unique // "starter" | "pro" | "enterprise" | custom
  name              String   // "Starter Plan"
  description       String?

  // Limits
  maxAgents         Int      @map("max_agents")
  maxIntegrations   Int      @map("max_integrations")
  maxWorkspaceUsers Int      @map("max_workspace_users")
  maxTokensPerMonth BigInt   @map("max_tokens_per_month")
  allowedChannels   String[] @map("allowed_channels") // ["web", "api", "whatsapp"]

  // Pricing (for display, not billing — billing is via invitation codes)
  priceMonthly      Decimal? @db.Decimal(10, 2) @map("price_monthly")
  priceCurrency     String   @default("USD") @map("price_currency")

  // Status
  isActive          Boolean  @default(true) @map("is_active")
  displayOrder      Int      @default(0) @map("display_order")

  // Relations
  invitationCodes   InvitationCode[]
  userSubscriptions UserSubscription[]

  createdAt         DateTime @default(now()) @db.Timestamptz()
  updatedAt         DateTime @updatedAt @db.Timestamptz()

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String           @id @default(uuid())
  userId             String           @unique @map("user_id")
  user               User             @relation(fields: [userId], references: [id])
  planId             String           @map("plan_id")
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])

  status             String           @default("active") // "active" | "canceled" | "expired"
  currentPeriodStart DateTime         @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd   DateTime         @map("current_period_end") @db.Timestamptz()

  cancelAtPeriodEnd  Boolean          @default(false) @map("cancel_at_period_end")
  createdAt          DateTime         @default(now()) @db.Timestamptz()
  updatedAt          DateTime         @updatedAt @db.Timestamptz()

  @@index([userId, status])
  @@index([planId])
  @@map("user_subscriptions")
}

// ─── Invitation Code System ─────────────────────────────────────────────────────

model InvitationCode {
  id              String    @id @default(uuid())
  code            String    @unique // e.g. "PERF-XXXX-XXXX"
  type            String    // "topup" | "subscription" | "both"

  // Top-up reward
  creditAmount    Decimal?  @db.Decimal(12, 6) @map("credit_amount")

  // Subscription reward
  planId          String?   @map("plan_id")
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  durationDays    Int?      @map("duration_days") // How many days the plan is granted

  // Usage limits
  maxRedemptions  Int       @default(1) @map("max_redemptions")
  timesRedeemed   Int       @default(0) @map("times_redeemed")

  // Validity (defaults to 2 months from creation)
  expiresAt       DateTime  @default(dbgenerated("(now() + '2 mons'::interval)")) @map("expires_at") @db.Timestamptz()
  isActive        Boolean   @default(true) @map("is_active")

  // Tracking
  createdById     String?   @map("created_by_id")
  redemptions     CodeRedemption[]
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("invitation_codes")
}

model CodeRedemption {
  id              String         @id @default(uuid())
  codeId          String         @map("code_id")
  code            InvitationCode @relation(fields: [codeId], references: [id])
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id])

  // What was granted
  creditsGranted  Decimal?       @db.Decimal(12, 6) @map("credits_granted")
  planGranted     String?        @map("plan_granted") // plan slug snapshot
  daysGranted     Int?           @map("days_granted")

  redeemedAt      DateTime       @default(now()) @map("redeemed_at") @db.Timestamptz()

  @@unique([codeId, userId]) // Each user can redeem a code only once
  @@index([userId])
  @@map("code_redemptions")
}

// ─── Better Auth Tables ─────────────────────────────────────────────────────────

model Account {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
