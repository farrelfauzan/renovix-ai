generator client {
  provider        = "prisma-client"
  output          = "../apps/api/src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  emailVerified Boolean        @default(false) @map("email_verified")
  password      String?        // Nullable — SSO users won't have a password

  // Profile fields
  name          String?
  firstName     String?        @map("first_name")
  lastName      String?        @map("last_name")
  avatar        String?        // URL to profile picture
  phone         String?
  company       String?
  jobTitle      String?        @map("job_title")
  timezone      String?        @default("UTC")
  locale        String?        @default("en")

  // Auth
  apiKey        String         @unique @default(uuid())
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz()
  lastLoginIp   String?        @map("last_login_ip")

  // Status
  status        String         @default("active") // "active" | "suspended" | "deleted"

  // Billing
  balance       Decimal        @default(0) @db.Decimal(12, 6)

  // Better Auth relations
  accounts      Account[]
  sessions      Session[]

  // Existing relations
  createdAt     DateTime       @default(now()) @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @db.Timestamptz()
  usageLogs     UsageLog[]
  transactions  Transaction[]
  conversations Conversation[]
  knowledgeBases KnowledgeBase[]
  portalSessions PortalSession[]
  memories      UserMemory[]
  agents        Agent[]
  subscription  UserSubscription?
  codeRedemptions CodeRedemption[]
  channels      Channel[]
  ownedWorkspaces    Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  workspaceInvitesSent WorkspaceInvite[] @relation("InviteSender")
  mcpCredentials UserMcpCredential[]
  mcpOAuthStates McpOAuthState[]
  guardrailViolations GuardrailViolation[]
  reminders       Reminder[]
  purchaseSnapshots PurchaseSnapshot[]

  @@map("users")
}

model UsageLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  model        String
  inputTokens  Int
  outputTokens Int
  cost         Decimal  @db.Decimal(12, 6)
  latencyMs    Int
  provider     String
  createdAt    DateTime @default(now()) @db.Timestamptz()

  @@index([userId])
  @@index([createdAt])

  @@map("usage_logs")
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(12, 6)
  type      String   // "topup" | "deduction" | "refund"
  status    String   // "pending" | "success" | "failed"
  reference String?  @unique // Stripe/Xendit payment ID
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([userId])
  @@index([createdAt])

  @@map("transactions")
}

model AiModel {
  id               String   @id @default(uuid())
  slug             String   @unique
  modelName        String   @map("model_name")
  provider         String   @default("openrouter")
  providerId       String   @map("provider_id")
  inputPrice       Decimal  @db.Decimal(18, 12) @map("input_price")
  outputPrice      Decimal  @db.Decimal(18, 12) @map("output_price")
  /// RX-21: the provider's cached-input price; null when the provider reports none yet.
  cachedInputPrice Decimal? @db.Decimal(18, 12) @map("cached_input_price")
  /// RX-21: when the price-refresh job last updated this row's prices.
  priceUpdatedAt   DateTime? @map("price_updated_at") @db.Timestamptz()
  maxTokens        Int      @map("max_tokens")
  maxOutputTokens  Int?     @map("max_output_tokens")
  tier             String   @default("standard")
  creditMultiplier Decimal  @default(1.0) @db.Decimal(6, 2) @map("credit_multiplier")
  planRequired     String   @default("free") @map("plan_required")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz()
  updatedAt        DateTime @updatedAt @db.Timestamptz()

  @@index([tier])
  @@index([active, tier])
  @@map("ai_models")
}

/// RX-21: the tier rate table, one row per tier. Each column holds the tier's rate for one
/// token kind as docs/credits.md defines it: CREDITS PER 1,000,000 TOKENS of that kind
/// (column names keep the short form). The adopted values (Standard 1/1/1, Advanced 5/4/6,
/// Premium 10/11/20, Frontier 17/25/17 for input/cached/output) come only from
/// prisma/tier-rates.seed.json (`bun run seed:tier-rates`); no rate is written in code.
model TierRate {
  tier                   String   @id @unique
  /// Credits per 1,000,000 tokens (not per token; the name keeps the short form, rename with RX-22).
  inputCreditsPerToken  Decimal  @map("input_credits_per_token") @db.Decimal(18, 12)
  /// Credits per 1,000,000 tokens (not per token; the name keeps the short form, rename with RX-22).
  cachedCreditsPerToken Decimal  @map("cached_credits_per_token") @db.Decimal(18, 12)
  /// Credits per 1,000,000 tokens (not per token; the name keeps the short form, rename with RX-22).
  outputCreditsPerToken  Decimal  @map("output_credits_per_token") @db.Decimal(18, 12)
  updatedAt             DateTime @updatedAt @db.Timestamptz()

  @@map("tier_rates")
}

model AppConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("app_configs")
}

model SystemPrompt {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  active    Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([active])
  @@map("system_prompts")
}

model PromptTemplate {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String
  content      String
  keywords     String[] // keywords used for intent matching
  active       Boolean  @default(true)
  priority     Int      @default(0)
  outputFormat String?  @map("output_format") // "pdf" | "docx" | "xlsx" | null
  createdAt    DateTime @default(now()) @db.Timestamptz()
  updatedAt    DateTime @updatedAt @db.Timestamptz()

  @@index([active])
  @@map("prompt_templates")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String?
  model     String
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  messages  Message[]

  @@index([userId])
  @@index([updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" | "assistant" | "system"
  content        String
  documentFormat String?      @map("document_format")
  documentFilename String?    @map("document_filename")
  documentKey    String?      @map("document_key")
  createdAt      DateTime     @default(now()) @db.Timestamptz()

  @@index([conversationId])
  @@map("messages")
}

model KnowledgeBase {
  id          String           @id @default(uuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])
  workspaceId String?          @map("workspace_id")
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @db.Timestamptz()
  chunks      KnowledgeChunk[]
  agentKnowledgeBases AgentKnowledgeBase[]

  @@index([userId])
  @@index([workspaceId])
  @@map("knowledge_bases")
}

model KnowledgeChunk {
  id              String        @id @default(uuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  content         String
  metadata        Json?
  embedding       Unsupported("vector(1024)")?
  tokenCount      Int
  createdAt       DateTime      @default(now()) @db.Timestamptz()

  @@index([knowledgeBaseId])
  @@map("knowledge_chunks")
}

model PortalSession {
  id            String    @id @default(uuid())
  sessionToken  String    @unique
  requestCount  Int       @default(0)
  ipAddress     String?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  lastRequestAt DateTime? @db.Timestamptz()
  lastResetAt   DateTime  @default(now()) @db.Timestamptz()
  createdAt     DateTime  @default(now()) @db.Timestamptz()

  @@index([userId])
  @@index([lastResetAt])
  @@index([ipAddress])
  @@map("portal_sessions")
}

/// Daily free-tier request counters (RX-10). bucket: "ip:<hmac hex>" or "global"; day: Asia/Jakarta date.
model AnonymousUsageCounter {
  bucket String
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([bucket, day])
  @@map("anonymous_usage_counters")
}

model UserMemory {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  type                 String    // "interest" | "preference" | "context" | "exclusion"
  content              String
  confidence           Float     @default(0.75)
  sourceMessageId      String?   @map("source_message_id")
  sourceConversationId String?   @map("source_conversation_id")
  lastConfirmedAt      DateTime  @default(now()) @db.Timestamptz()
  expiresAt            DateTime? @db.Timestamptz()
  isUserPinned         Boolean   @default(false) @map("is_user_pinned")
  status               String    @default("active") // "active" | "archived" | "deleted"
  createdAt            DateTime  @default(now()) @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @db.Timestamptz()

  @@index([userId, status])
  @@index([userId, type])
  @@map("user_memories")
}

// ─── AI Agent Portal Models ─────────────────────────────────────────────────────

model Agent {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  parentAgentId   String?         @map("parent_agent_id")
  parentAgent     Agent?          @relation("SubAgents", fields: [parentAgentId], references: [id], onDelete: SetNull)
  subAgents       Agent[]         @relation("SubAgents")
  workspaceId     String?         @map("workspace_id")
  workspace       Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name            String
  slug            String
  description     String?
  avatar          String?
  avatarColor     String?         @default("#6366f1") @map("avatar_color")
  systemPrompt    String          @map("system_prompt")
  model           String
  temperature     Float           @default(0.7)
  maxTokens       Int?            @map("max_tokens")
  status          String          @default("draft") // "draft" | "active" | "archived"
  isPublic        Boolean         @default(false) @map("is_public")
  agentType       String          @default("standalone") @map("agent_type") // "standalone" | "parent" | "sub_agent"
  tools           AgentTool[]
  integrations    AgentIntegration[]
  knowledgeBases  AgentKnowledgeBase[]
  channels        AgentChannel[]
  runs            AgentRun[]
  channelAgents   ChannelAgent[]
  guardrailViolations GuardrailViolation[]
  guardrailConfig     GuardrailConfig?
  reminders       Reminder[]
  createdAt       DateTime        @default(now()) @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @db.Timestamptz()

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([parentAgentId])
  @@index([isPublic])
  @@index([workspaceId, status])
  @@map("agents")
}

model AgentIntegration {
  id              String   @id @default(uuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider        String   // "jira" | "plane" | "google_calendar" | "outlook" | "notion" | "slack" | "github"
  config          Json     // { baseUrl, apiKey (encrypted), projectId, etc. }
  scopes          String[] // permitted actions
  status          String   @default("connected") // "connected" | "expired" | "revoked"
  createdAt       DateTime @default(now()) @db.Timestamptz()
  updatedAt       DateTime @updatedAt @db.Timestamptz()

  @@unique([agentId, provider])
  @@index([agentId])
  @@map("agent_integrations")
}

model AgentTool {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolType  String   @map("tool_type") // "web_search" | "calculator" | "api_call" | "knowledge_retrieval"
  config    Json?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([agentId])
  @@map("agent_tools")
}

model AgentKnowledgeBase {
  id              String        @id @default(uuid())
  agentId         String
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String        @map("knowledge_base_id")
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id])
  createdAt       DateTime      @default(now()) @db.Timestamptz()

  @@unique([agentId, knowledgeBaseId])
  @@map("agent_knowledge_bases")
}

model AgentChannel {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channelType String   @map("channel_type") // "web" | "whatsapp" | "api"
  config      Json?
  status      String   @default("active") // "active" | "paused" | "disconnected"
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()

  @@unique([agentId, channelType])
  @@index([channelType, status])
  @@map("agent_channels")
}

model AgentRun {
  id             String          @id @default(uuid())
  agentId        String
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId      String          @map("session_id")
  channelType    String          @map("channel_type") // "web" | "whatsapp" | "api"
  externalUserId String?         @map("external_user_id")
  status         String          @default("active") // "active" | "completed" | "error"
  messages       AgentMessage[]
  metadata       Json?
  createdAt      DateTime        @default(now()) @db.Timestamptz()
  updatedAt      DateTime        @updatedAt @db.Timestamptz()

  @@index([agentId])
  @@index([sessionId])
  @@index([externalUserId])
  @@map("agent_runs")
}

model AgentMessage {
  id         String   @id @default(uuid())
  runId      String   @map("run_id")
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  role       String   // "user" | "assistant" | "system" | "tool"
  content    String
  toolCalls  Json?    @map("tool_calls")
  toolResult Json?    @map("tool_result")
  tokens     Int?
  cost       Decimal? @db.Decimal(12, 6)
  createdAt  DateTime @default(now()) @db.Timestamptz()

  @@index([runId])
  @@map("agent_messages")
}

model SubscriptionPlan {
  id                String   @id @default(uuid())
  slug              String   @unique // "starter" | "pro" | "enterprise" | custom
  name              String   // "Starter Plan"
  description       String?

  // Limits
  maxAgents         Int      @map("max_agents")
  maxIntegrations   Int      @map("max_integrations")
  maxWorkspaceUsers Int      @map("max_workspace_users")
  maxTokensPerMonth BigInt   @map("max_tokens_per_month")
  allowedChannels   String[] @map("allowed_channels") // ["web", "api", "whatsapp"]

  // Pricing (for display, not billing — billing is via invitation codes)
  priceMonthly      Decimal? @db.Decimal(10, 2) @map("price_monthly")
  priceCurrency     String   @default("USD") @map("price_currency")

  // Status
  isActive          Boolean  @default(true) @map("is_active")
  displayOrder      Int      @default(0) @map("display_order")

  // Relations
  invitationCodes   InvitationCode[]
  userSubscriptions UserSubscription[]

  createdAt         DateTime @default(now()) @db.Timestamptz()
  updatedAt         DateTime @updatedAt @db.Timestamptz()

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String           @id @default(uuid())
  userId             String           @unique @map("user_id")
  user               User             @relation(fields: [userId], references: [id])
  planId             String           @map("plan_id")
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])

  status             String           @default("active") // "active" | "canceled" | "expired"
  currentPeriodStart DateTime         @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd   DateTime         @map("current_period_end") @db.Timestamptz()

  // Usage tracking
  messagesUsed       Int              @default(0) @map("messages_used")
  tokensUsed         BigInt           @default(0) @map("tokens_used")

  cancelAtPeriodEnd  Boolean          @default(false) @map("cancel_at_period_end")
  createdAt          DateTime         @default(now()) @db.Timestamptz()
  updatedAt          DateTime         @updatedAt @db.Timestamptz()

  @@index([userId, status])
  @@index([planId])
  @@map("user_subscriptions")
}

// ─── Invitation Code System ─────────────────────────────────────────────────────

model InvitationCode {
  id              String    @id @default(uuid())
  code            String    @unique // e.g. "PERF-XXXX-XXXX"
  type            String    // "topup" | "subscription" | "both"

  // Top-up reward
  creditAmount    Decimal?  @db.Decimal(12, 6) @map("credit_amount")

  // Subscription reward
  planId          String?   @map("plan_id")
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  durationDays    Int?      @map("duration_days") // How many days the plan is granted

  // Usage limits
  maxRedemptions  Int       @default(1) @map("max_redemptions")
  timesRedeemed   Int       @default(0) @map("times_redeemed")

  // Validity (defaults to 2 months from creation)
  expiresAt       DateTime  @default(dbgenerated("(now() + '2 mons'::interval)")) @map("expires_at") @db.Timestamptz()
  isActive        Boolean   @default(true) @map("is_active")

  // Tracking
  createdById     String?   @map("created_by_id")
  redemptions     CodeRedemption[]
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("invitation_codes")
}

model CodeRedemption {
  id              String         @id @default(uuid())
  codeId          String         @map("code_id")
  code            InvitationCode @relation(fields: [codeId], references: [id])
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id])

  // What was granted
  creditsGranted  Decimal?       @db.Decimal(12, 6) @map("credits_granted")
  planGranted     String?        @map("plan_granted") // plan slug snapshot
  daysGranted     Int?           @map("days_granted")

  redeemedAt      DateTime       @default(now()) @map("redeemed_at") @db.Timestamptz()

  @@unique([codeId, userId]) // Each user can redeem a code only once
  @@index([userId])
  @@map("code_redemptions")
}

// ─── Better Auth Tables ─────────────────────────────────────────────────────────

model Account {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String    @map("account_id")      // Provider's user ID
  providerId           String    @map("provider_id")     // "google" | "github" | "credential"
  accessToken          String?   @map("access_token")
  refreshToken         String?   @map("refresh_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz()
  scope                String?
  idToken              String?   @map("id_token")
  password             String?   // For credential provider (bcrypt hash)
  createdAt            DateTime  @default(now()) @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @db.Timestamptz()

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String   // email or phone
  value      String   // token/code
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @db.Timestamptz()
  updatedAt  DateTime @updatedAt @db.Timestamptz()

  @@map("verifications")
}

// ─── Channels System (Discord-like) ───

model Channel {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  name      String
  icon      String?
  color     String?        @default("#6366f1")
  agents    ChannelAgent[]
  rooms     ChannelChatRoom[]
  reminders Reminder[]
  workspace Workspace?
  createdAt DateTime       @default(now()) @db.Timestamptz()
  updatedAt DateTime       @updatedAt @db.Timestamptz()

  @@index([userId])
  @@map("channels")
}

model ChannelAgent {
  id        String           @id @default(uuid())
  channelId String           @map("channel_id")
  channel   Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agentId   String           @map("agent_id")
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  role      String           @default("primary") // "primary" | "sub"
  createdAt DateTime         @default(now()) @db.Timestamptz()

  @@unique([channelId, agentId])
  @@index([channelId])
  @@index([agentId])
  @@map("channel_agents")
}

model ChannelChatRoom {
  id        String           @id @default(uuid())
  channelId String           @map("channel_id")
  channel   Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String           @default("general")
  messages  ChannelMessage[]
  reminders Reminder[]
  createdAt DateTime         @default(now()) @db.Timestamptz()
  updatedAt DateTime         @updatedAt @db.Timestamptz()

  @@index([channelId])
  @@map("channel_chat_rooms")
}

model ChannelMessage {
  id         String          @id @default(uuid())
  chatRoomId String          @map("chat_room_id")
  chatRoom   ChannelChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  agentId    String?         @map("agent_id")
  role       String          // "user" | "assistant"
  content    String
  tokens     Int?
  cost       Decimal?        @db.Decimal(12, 6)
  metadata   Json?           @db.JsonB
  createdAt  DateTime        @default(now()) @db.Timestamptz()

  @@index([chatRoomId])
  @@index([agentId])
  @@map("channel_messages")
}

// ─── Workspace Models ───────────────────────────────────────────────────────────

model Workspace {
  id          String            @id @default(uuid())
  channelId   String?           @unique @map("channel_id")
  channel     Channel?          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  ownerId     String            @map("owner_id")
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  name        String
  slug        String
  description String?
  avatar      String?
  status      String            @default("active") // "active" | "archived" | "deleted"
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  memories    WorkspaceMemory[]
  knowledgeBases KnowledgeBase[]
  agents      Agent[]
  userMcpCredentials UserMcpCredential[]
  mcpOAuthStates McpOAuthState[]
  createdAt   DateTime          @default(now()) @db.Timestamptz()
  updatedAt   DateTime          @updatedAt @db.Timestamptz()

  @@index([ownerId, status])
  @@index([channelId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // "owner" | "admin" | "member" | "viewer"
  status      String    @default("active") // "active" | "removed"
  joinedAt    DateTime? @map("joined_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  emailNormalized String    @map("email_normalized")
  tokenHash       String    @unique @map("token_hash")
  role            String    @default("member") // "admin" | "member" | "viewer"
  status          String    @default("pending") // "pending" | "accepted" | "expired" | "revoked"
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz()
  invitedById     String    @map("invited_by_id")
  invitedBy       User      @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedById    String?   @map("accepted_by_id")
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  @@index([workspaceId, status])
  @@index([emailNormalized, status])
  @@map("workspace_invites")
}

model WorkspaceMemory {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type            String    // "fact" | "preference" | "policy" | "context" | "exclusion"
  content         String
  confidence      Float     @default(0.75)
  sourceRunId     String?   @map("source_run_id")
  createdById     String?   @map("created_by_id")
  lastConfirmedAt DateTime  @default(now()) @map("last_confirmed_at") @db.Timestamptz()
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  isPinned        Boolean   @default(false) @map("is_pinned")
  status          String    @default("active") // "active" | "archived" | "deleted"
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@map("workspace_memories")
}

// ─── Email Jobs (Outbox) ────────────────────────────────────────────────────────

model EmailJob {
  id                String    @id @default(uuid())
  type              String    // "workspace_invite"
  recipientEmail    String    @map("recipient_email")
  payload           Json
  status            String    @default("pending") // "pending" | "sending" | "sent" | "failed"
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.Timestamptz()
  provider          String?
  providerMessageId String?   @map("provider_message_id")
  createdAt         DateTime  @default(now()) @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @db.Timestamptz()

  @@index([status, nextAttemptAt])
  @@map("email_jobs")
}

// ─── User MCP Credentials ───────────────────────────────────────────────────────

model UserMcpCredential {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        String    // "google-gmail" | "google-calendar" | "google-sheets" | "github" | "slack"
  envEncrypted    String    @map("env_encrypted") // AES-256-GCM encrypted JSON with tokens
  status          String    @default("connected") // "connected" | "expired" | "revoked"
  connectedAt     DateTime  @default(now()) @map("connected_at") @db.Timestamptz()
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  @@unique([userId, workspaceId, provider])
  @@index([userId, workspaceId])
  @@index([workspaceId, provider])
  @@map("user_mcp_credentials")
}

// One-time values of the MCP OAuth flows that were started and not yet finished (RX-151).
// The callback deletes the row that matches its signed state; a second use finds none.
model McpOAuthState {
  nonce       String    @id
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([expiresAt])
  @@map("mcp_oauth_states")
}

// ─── Guardrail Models ───────────────────────────────────────────────────────────

model GuardrailViolation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  agentId   String?  @map("agent_id")
  agent     Agent?   @relation(fields: [agentId], references: [id])
  type      String   // "prompt_injection" | "content_policy" | "rate_abuse" | "pii_leak" | "toxic_output"
  severity  String   // "low" | "medium" | "high" | "critical"
  input     String?  // user input that triggered violation (truncated)
  output    String?  // model output that was blocked (truncated)
  action    String   // "warned" | "blocked" | "cooldown" | "suspended"
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("guardrail_violations")
}

model GuardrailConfig {
  id                   String   @id @default(uuid())
  agentId              String?  @unique @map("agent_id")
  agent                Agent?   @relation(fields: [agentId], references: [id])
  enableInputFilter    Boolean  @default(true) @map("enable_input_filter")
  enableOutputFilter   Boolean  @default(true) @map("enable_output_filter")
  enablePIIMasking     Boolean  @default(false) @map("enable_pii_masking")
  enableInjectionCheck Boolean  @default(true) @map("enable_injection_check")
  toxicityThreshold    Float    @default(0.7) @map("toxicity_threshold")
  maxResponseLength    Int      @default(16000) @map("max_response_length")
  blockedTopics        String[] @default([]) @map("blocked_topics")
  createdAt            DateTime @default(now()) @db.Timestamptz()
  updatedAt            DateTime @updatedAt @db.Timestamptz()

  @@map("guardrail_configs")
}

// ─── Reminder / Notification Models ─────────────────────────────────────────────

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

model Reminder {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id])
  agentId         String          @map("agent_id")
  agent           Agent           @relation(fields: [agentId], references: [id])
  channelId       String          @map("channel_id")
  channel         Channel         @relation(fields: [channelId], references: [id])
  chatRoomId      String          @map("chat_room_id")
  chatRoom        ChannelChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  // Reminder content
  prompt          String          // The instruction/question the agent should execute
  description     String?         // Human-readable label (e.g., "Daily expense summary")

  // Schedule (cron expression)
  cronExpression  String          @map("cron_expression") // e.g., "0 8 * * *"
  timezone        String          @default("UTC")

  // Execution tracking
  nextRunAt       DateTime        @map("next_run_at") @db.Timestamptz()
  lastRunAt       DateTime?       @map("last_run_at") @db.Timestamptz()
  consecutiveFailures Int         @default(0) @map("consecutive_failures")
  lastError       String?         @map("last_error")
  status          ReminderStatus  @default(ACTIVE)

  // Metadata
  createdAt       DateTime        @default(now()) @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @db.Timestamptz()
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz()

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("reminders")
}

// ─── Back-office staff identity (RX-94) ─────────────────────────────────────────
// Separate from User: staff never sign in with a product account (D60). No route creates an
// AdminUser; the first one comes from scripts/create-admin.ts, the next ones from invitations (RX-95).

/// A back-office staff account. email is stored lowercased. role: the name of an AdminRole (RX-96).
model AdminUser {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String    @map("password_hash") // Argon2id, PHC string
  role                 String
  adminRole            AdminRole @relation(fields: [role], references: [name], onDelete: Restrict, onUpdate: Cascade)
  totpSecretEncrypted  String?   @map("totp_secret_encrypted") // AES-256-GCM; set at enrolment, active once totpEnrolledAt is set
  totpEnrolledAt       DateTime? @map("totp_enrolled_at") @db.Timestamptz()
  lastAcceptedTimeStep Int?      @map("last_accepted_time_step") // TOTP step last accepted: a code of this step or earlier is refused
  failedAttempts       Int       @default(0) @map("failed_attempts")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  recoveryCodes      AdminRecoveryCode[]
  sessions           AdminSession[]
  notificationsAbout AdminNotification[]
  piiGrants          AdminPiiGrant[]     @relation("PiiGrantHolder")
  piiGrantsGiven     AdminPiiGrant[]     @relation("PiiGrantGranter")
  auditLog           AdminAuditLog[]

  @@index([role])
  @@map("admin_users")
}

/// A back-office role (RX-96, PRD 09 F5): a named set of `resource:action` staff permissions. The five
/// built-in roles (owner, operations, finance, support, viewer) are seeded by their migration.
model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  builtIn     Boolean  @default(false) @map("built_in")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  admins AdminUser[]

  @@map("admin_roles")
}

/// A per-case grant (D56): the admin may reveal the personal data of one user until expiresAt.
model AdminPiiGrant {
  id               String    @id @default(uuid())
  adminId          String    @map("admin_id")
  admin            AdminUser @relation("PiiGrantHolder", fields: [adminId], references: [id], onDelete: Cascade)
  subjectUserId    String    @map("subject_user_id")
  reason           String
  grantedByAdminId String    @map("granted_by_admin_id")
  grantedBy        AdminUser @relation("PiiGrantGranter", fields: [grantedByAdminId], references: [id], onDelete: Restrict)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([adminId, subjectUserId, expiresAt])
  @@index([grantedByAdminId])
  @@map("admin_pii_grants")
}

/// One recovery code of an admin, stored as its SHA-256 hash; shown once at enrolment, usable once.
model AdminRecoveryCode {
  id        String    @id @default(uuid())
  adminId   String    @map("admin_id")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([adminId, codeHash])
  @@map("admin_recovery_codes")
}

/// One sign-in of an admin (D54). scope: "enrolment" (TOTP not enrolled yet) | "full". The refresh token
/// is "<id>.<random>"; only its SHA-256 hash is stored. Every rotation moves the old hash to
/// usedRefreshTokenHashes, so a rotated token presented again is recognised and ends the session.
model AdminSession {
  id                     String    @id @default(uuid())
  adminId                String    @map("admin_id")
  admin                  AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  scope                  String
  refreshTokenHash       String    @map("refresh_token_hash")
  usedRefreshTokenHashes String[]  @default([]) @map("used_refresh_token_hashes")
  userAgent              String?   @map("user_agent")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastSeenAt             DateTime  @map("last_seen_at") @db.Timestamptz()
  absoluteExpiresAt      DateTime  @map("absolute_expires_at") @db.Timestamptz()
  lastReauthAt           DateTime? @map("last_reauth_at") @db.Timestamptz()
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz()

  @@index([adminId])
  @@map("admin_sessions")
}

/// An in-app notification for the back office. recipientRole: "owner"; kind: "lockout".
model AdminNotification {
  id             String     @id @default(uuid())
  recipientRole  String     @map("recipient_role")
  kind           String
  subjectAdminId String?    @map("subject_admin_id")
  subjectAdmin   AdminUser? @relation(fields: [subjectAdminId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  readAt         DateTime?  @map("read_at") @db.Timestamptz()

  @@index([subjectAdminId])
  @@map("admin_notifications")
}

// ─── Offer catalog and platform settings (RX-86, docs/credits.md section 9) ─────
// Offers are rows managed in the back office, never code (D46); values come from prisma/offers.seed.json
// (`bun run seed:offers`) until the catalog screens exist (RX-98). SubscriptionPlan, UserSubscription and
// InvitationCode stay as they are: live code (agent.service.ts, the billing and codes repositories) still reads them;
// retiring them is later work. Version rows, purchase snapshots and change records are append-only: a
// trigger refuses every UPDATE and DELETE (migration 20261015150000_offer_catalog).

/// How a package version is paid: once (Starter, Pro: limits unlocked for good, D37) or every month.
enum PackageBilling {
  one_time
  monthly
}

/// The kind of catalog row or setting a CatalogChange is about.
enum CatalogEntity {
  package
  package_version
  top_up_pack
  top_up_pack_version
  enterprise_bundle
  enterprise_bundle_version
  company_contract
  platform_setting
  /// RX-21: a tier's credit rates (tier-rate seed) and a provider price refresh (ai_models row).
  tier_rate
  ai_model
}

/// A package (Starter, Pro, Enterprise). Price, credits and limits live on its versions.
model Package {
  id           String           @id @default(uuid())
  name         String           @unique
  displayOrder Int              @map("display_order")
  active       Boolean
  visible      Boolean
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  versions     PackageVersion[]

  @@map("packages")
}

/// One version of a package's terms. Append-only: a change creates the next version. The current version
/// is the highest versionNumber whose effectiveFrom has passed.
model PackageVersion {
  id                String             @id @default(uuid())
  packageId         String             @map("package_id")
  package           Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  versionNumber     Int                @map("version_number")
  priceRupiah       Int                @map("price_rupiah")
  creditsGranted    Decimal            @map("credits_granted") @db.Decimal(18, 6)
  billing           PackageBilling
  maxAgents         Int                @map("max_agents")
  maxConnectedTools Int                @map("max_connected_tools")
  apiAccess         Boolean            @map("api_access")
  allowedChannels   String[]           @map("allowed_channels")
  allowedTiers      String[]           @map("allowed_tiers")
  effectiveFrom     DateTime           @default(now()) @map("effective_from") @db.Timestamptz()
  createdBy         String             @map("created_by")
  reason            String
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  purchases         PurchaseSnapshot[]

  @@unique([packageId, versionNumber])
  @@map("package_versions")
}

/// A top-up pack, sold only to accounts with a package (D36). Its terms live on its versions.
model TopUpPack {
  id        String             @id @default(uuid())
  name      String             @unique
  active    Boolean
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  versions  TopUpPackVersion[]

  @@map("top_up_packs")
}

/// One version of a top-up pack's terms. Append-only.
model TopUpPackVersion {
  id             String             @id @default(uuid())
  packId         String             @map("pack_id")
  pack           TopUpPack          @relation(fields: [packId], references: [id], onDelete: Restrict)
  versionNumber  Int                @map("version_number")
  creditsGranted Decimal            @map("credits_granted") @db.Decimal(18, 6)
  priceRupiah    Int                @map("price_rupiah")
  effectiveFrom  DateTime           @default(now()) @map("effective_from") @db.Timestamptz()
  createdBy      String             @map("created_by")
  reason         String
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  purchases      PurchaseSnapshot[]

  @@unique([packId, versionNumber])
  @@map("top_up_pack_versions")
}

/// An Enterprise bundle. Its amounts live on its versions.
model EnterpriseBundle {
  id        String                    @id @default(uuid())
  name      String                    @unique
  active    Boolean
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()
  versions  EnterpriseBundleVersion[]

  @@map("enterprise_bundles")
}

/// One version of an Enterprise bundle. Append-only. The amounts are D1 (open): nullable, no defaults.
model EnterpriseBundleVersion {
  id                   String            @id @default(uuid())
  bundleId             String            @map("bundle_id")
  bundle               EnterpriseBundle  @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  versionNumber        Int               @map("version_number")
  poolCreditsPerPeriod Decimal?          @map("pool_credits_per_period") @db.Decimal(18, 6)
  monthlyPriceRupiah   Int?              @map("monthly_price_rupiah")
  effectiveFrom        DateTime          @default(now()) @map("effective_from") @db.Timestamptz()
  createdBy            String            @map("created_by")
  reason               String
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  contracts            CompanyContract[]

  @@unique([bundleId, versionNumber])
  @@map("enterprise_bundle_versions")
}

/// An Enterprise company's contract, filled when a proposal is accepted (RX-32, RX-101). companyId has no
/// foreign key until the company account exists. graceDays (D27), capPolicy (D2) and topUpRoles (D18) are
/// open decisions: nullable, no defaults. defaultMemberShareCredits null means the fair share (grant ÷ seats).
model CompanyContract {
  id                        String                  @id @default(uuid())
  companyId                 String                  @map("company_id")
  bundleVersionId           String                  @map("bundle_version_id")
  bundleVersion             EnterpriseBundleVersion @relation(fields: [bundleVersionId], references: [id], onDelete: Restrict)
  seatLimit                 Int                     @map("seat_limit")
  defaultMemberShareCredits Decimal?                @map("default_member_share_credits") @db.Decimal(18, 6)
  allowedTiers              String[]                @map("allowed_tiers")
  graceDays                 Int?                    @map("grace_days")
  whatsappEnabled           Boolean                 @map("whatsapp_enabled")
  capPolicy                 String?                 @map("cap_policy")
  topUpRoles                Json?                   @map("top_up_roles")
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([companyId])
  @@index([bundleVersionId])
  @@map("company_contracts")
}

/// What a buyer bought, copied from the version at the time of purchase (D37: permanent). Exactly one of
/// packageVersionId and topUpPackVersionId is set (CHECK). Append-only. For a top-up pack the limits
/// are null and the lists empty.
model PurchaseSnapshot {
  id                 String            @id @default(uuid())
  buyerUserId        String            @map("buyer_user_id")
  buyer              User              @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  packageVersionId   String?           @map("package_version_id")
  packageVersion     PackageVersion?   @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  topUpPackVersionId String?           @map("top_up_pack_version_id")
  topUpPackVersion   TopUpPackVersion? @relation(fields: [topUpPackVersionId], references: [id], onDelete: Restrict)
  priceRupiah        Int               @map("price_rupiah")
  creditsGranted     Decimal           @map("credits_granted") @db.Decimal(18, 6)
  billing            PackageBilling?
  maxAgents          Int?              @map("max_agents")
  maxConnectedTools  Int?              @map("max_connected_tools")
  apiAccess          Boolean?          @map("api_access")
  allowedChannels    String[]          @map("allowed_channels")
  allowedTiers       String[]          @map("allowed_tiers")
  paymentId          String?           @map("payment_id")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  @@index([buyerUserId, createdAt])
  @@index([packageVersionId])
  @@index([topUpPackVersionId])
  @@map("purchase_snapshots")
}

/// One platform setting. name is a key of the registry in apps/api/src/app/offers/config/platform-settings.ts,
/// whose Zod schema validates value on every write. A setting without a row is not set.
model PlatformSetting {
  name      String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("platform_settings")
}

/// One change to a catalog row or a platform setting: who (an admin id or an operator label such as
/// "seed:<name>"), why, when it takes effect, and the values before (null on create) and after. Append-only.
model CatalogChange {
  id            String        @id @default(uuid())
  entity        CatalogEntity
  entityId      String        @map("entity_id")
  changedBy     String        @map("changed_by")
  reason        String
  before        Json?
  after         Json
  effectiveFrom DateTime      @default(now()) @map("effective_from") @db.Timestamptz()
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entity, entityId, createdAt])
  @@map("catalog_changes")
}

/// One back-office write or personal-data reveal (RX-97, D57, D61): who (adminId), what (resource,
/// action), the values before and after (non-secret state only: never tokens, TOTP secrets, recovery
/// codes, password hashes or personal data), the reason the admin typed ("" when the route asks for
/// none), the request id, and when the change takes effect. Append-only, enforced in the database: the
/// trigger "admin_audit_log_append_only" (migration 20261015120000_admin_audit_log) refuses every UPDATE
/// and DELETE. Kept at least two years; nothing deletes rows. onDelete Restrict: an admin who has audit
/// rows cannot be deleted, so deleting an admin can never rewrite or orphan them.
model AdminAuditLog {
  id          String    @id @default(uuid())
  adminId     String    @map("admin_id")
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resource    String
  action      String
  before      Json
  after       Json
  reason      String
  requestId   String    @map("request_id")
  effectiveAt DateTime  @map("effective_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([adminId, createdAt])
  @@index([resource, createdAt])
  /// RX-164: the audit log screen reads newest first by (created_at, id); filtered by action too.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([action, createdAt])
  @@map("admin_audit_log")
}
