// ─── Workspace Models ───────────────────────────────────────────────────────────

model Workspace {
  id          String            @id @default(uuid())
  channelId   String?           @unique @map("channel_id")
  channel     Channel?          @relation(fields: [channelId], references: [id], onDelete: Restrict)
  ownerId     String            @map("owner_id")
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  name        String
  slug        String
  description String?
  avatar      String?
  status      String            @default("active") // "active" | "archived" | "deleted"
  /// The account's default workspace (RNX-117): one per owner, created at sign-up, never archived.
  isDefault   Boolean           @default(false) @map("is_default")
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  memories    WorkspaceMemory[]
  knowledgeBases KnowledgeBase[]
  agents      Agent[]
  userMcpCredentials UserMcpCredential[]
  mcpOAuthStates McpOAuthState[]
  createdAt   DateTime          @default(now()) @db.Timestamptz()
  updatedAt   DateTime          @updatedAt @db.Timestamptz()

  @@unique([ownerId], where: raw("is_default"))
  @@index([ownerId, status])
  @@index([channelId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // "owner" | "admin" | "member" | "viewer"
  status      String    @default("active") // "active" | "removed"
  joinedAt    DateTime? @map("joined_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  emailNormalized String    @map("email_normalized")
  tokenHash       String    @unique @map("token_hash")
  role            String    @default("member") // "admin" | "member" | "viewer"
  status          String    @default("pending") // "pending" | "accepted" | "expired" | "revoked"
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz()
  invitedById     String    @map("invited_by_id")
  invitedBy       User      @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedById    String?   @map("accepted_by_id")
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  @@index([workspaceId, status])
  @@index([emailNormalized, status])
  @@map("workspace_invites")
}

model WorkspaceMemory {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type            String    // "fact" | "preference" | "policy" | "context" | "exclusion"
  content         String
  confidence      Float     @default(0.75)
  sourceRunId     String?   @map("source_run_id")
  createdById     String?   @map("created_by_id")
  lastConfirmedAt DateTime  @default(now()) @map("last_confirmed_at") @db.Timestamptz()
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  isPinned        Boolean   @default(false) @map("is_pinned")
  status          String    @default("active") // "active" | "archived" | "deleted"
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@map("workspace_memories")
}

// ─── Email Jobs (Outbox) ────────────────────────────────────────────────────────

model EmailJob {
  id                String    @id @default(uuid())
  type              String    // "workspace_invite"
  recipientEmail    String    @map("recipient_email")
  payload           Json
  status            String    @default("pending") // "pending" | "sending" | "sent" | "failed"
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.Timestamptz()
  provider          String?
  providerMessageId String?   @map("provider_message_id")
  createdAt         DateTime  @default(now()) @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @db.Timestamptz()

  @@index([status, nextAttemptAt])
  @@map("email_jobs")
}

// ─── User MCP Credentials ───────────────────────────────────────────────────────

model UserMcpCredential {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        String    // "google-gmail" | "google-calendar" | "google-sheets" | "github" | "slack"
  envEncrypted    String    @map("env_encrypted") // AES-256-GCM encrypted JSON with tokens
  status          String    @default("connected") // "connected" | "expired" | "revoked"
  connectedAt     DateTime  @default(now()) @map("connected_at") @db.Timestamptz()
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  @@unique([userId, workspaceId, provider])
  @@index([userId, workspaceId])
  @@index([workspaceId, provider])
  @@map("user_mcp_credentials")
}

// One-time values of the MCP OAuth flows that were started and not yet finished (RX-151).
// The callback deletes the row that matches its signed state; a second use finds none.
model McpOAuthState {
  nonce       String    @id
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([expiresAt])
  @@map("mcp_oauth_states")
}

// ─── Guardrail Models ───────────────────────────────────────────────────────────

model GuardrailViolation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  agentId   String?  @map("agent_id")
  agent     Agent?   @relation(fields: [agentId], references: [id])
  type      String   // "prompt_injection" | "content_policy" | "rate_abuse" | "pii_leak" | "toxic_output"
  severity  String   // "low" | "medium" | "high" | "critical"
  input     String?  // user input that triggered violation (truncated)
  output    String?  // model output that was blocked (truncated)
  action    String   // "warned" | "blocked" | "cooldown" | "suspended"
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("guardrail_violations")
}

model GuardrailConfig {
  id                   String   @id @default(uuid())
  agentId              String?  @unique @map("agent_id")
  agent                Agent?   @relation(fields: [agentId], references: [id])
  enableInputFilter    Boolean  @default(true) @map("enable_input_filter")
  enableOutputFilter   Boolean  @default(true) @map("enable_output_filter")
  enablePIIMasking     Boolean  @default(false) @map("enable_pii_masking")
  enableInjectionCheck Boolean  @default(true) @map("enable_injection_check")
  toxicityThreshold    Float    @default(0.7) @map("toxicity_threshold")
  maxResponseLength    Int      @default(16000) @map("max_response_length")
  blockedTopics        String[] @default([]) @map("blocked_topics")
  createdAt            DateTime @default(now()) @db.Timestamptz()
  updatedAt            DateTime @updatedAt @db.Timestamptz()

  @@map("guardrail_configs")
}

// ─── Reminder / Notification Models ─────────────────────────────────────────────

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

model Reminder {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id])
  agentId         String          @map("agent_id")
  agent           Agent           @relation(fields: [agentId], references: [id])
  channelId       String          @map("channel_id")
  channel         Channel         @relation(fields: [channelId], references: [id])
  chatRoomId      String          @map("chat_room_id")
  chatRoom        ChannelChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  // Reminder content
  prompt          String          // The instruction/question the agent should execute
  description     String?         // Human-readable label (e.g., "Daily expense summary")

  // Schedule (cron expression)
  cronExpression  String          @map("cron_expression") // e.g., "0 8 * * *"
  timezone        String          @default("UTC")

  // Execution tracking
  nextRunAt       DateTime        @map("next_run_at") @db.Timestamptz()
  lastRunAt       DateTime?       @map("last_run_at") @db.Timestamptz()
  consecutiveFailures Int         @default(0) @map("consecutive_failures")
  lastError       String?         @map("last_error")
  status          ReminderStatus  @default(ACTIVE)

  // Metadata
  createdAt       DateTime        @default(now()) @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @db.Timestamptz()
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz()

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("reminders")
}

// ─── Back-office staff identity (RX-94) ─────────────────────────────────────────
// Separate from User: staff never sign in with a product account (D60). No route creates an
// AdminUser directly; the first one comes from scripts/create-admin.ts, the next ones from completed invitations (RX-95).

/// A back-office staff account. email is stored lowercased. role: the name of an AdminRole (RX-96).
model AdminUser {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String    @map("password_hash") // Argon2id, PHC string
  role                 String
  adminRole            AdminRole @relation(fields: [role], references: [name], onDelete: Restrict, onUpdate: Cascade)
  totpSecretEncrypted  String?   @map("totp_secret_encrypted") // AES-256-GCM; set at enrolment, active once totpEnrolledAt is set
  totpEnrolledAt       DateTime? @map("totp_enrolled_at") @db.Timestamptz()
  lastAcceptedTimeStep Int?      @map("last_accepted_time_step") // TOTP step last accepted: a code of this step or earlier is refused
  failedAttempts       Int       @default(0) @map("failed_attempts")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz()
  /// RX-95: set at invitation completion; null for admins made by scripts/create-admin.ts.
  name                 String?
  /// RX-95: a suspended admin cannot sign in, refresh or pass the access check (removal is a suspension, D123).
  suspendedAt          DateTime? @map("suspended_at") @db.Timestamptz()
  lastSignInAt         DateTime? @map("last_sign_in_at") @db.Timestamptz()
  /// RX-95: an Owner forced a password reset: the next session reaches only the change-password route.
  mustChangePassword   Boolean   @default(false) @map("must_change_password")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  recoveryCodes      AdminRecoveryCode[]
  sessions           AdminSession[]
  notificationsAbout AdminNotification[]
  piiGrants          AdminPiiGrant[]     @relation("PiiGrantHolder")
  piiGrantsGiven     AdminPiiGrant[]     @relation("PiiGrantGranter")
  auditLog           AdminAuditLog[]
  providersCreated   Provider[]          @relation("ProviderCreatedBy")
  providersUpdated   Provider[]          @relation("ProviderUpdatedBy")
  invitationsSent    AdminInvitation[]   @relation("AdminInvitationInviter")

  @@index([role])
  @@map("admin_users")
}

/// An invitation to the back office (RX-95): the AdminUser row is created only when it is completed.
/// Only the SHA-256 hash of the link's token is stored; the raw link is shown once to the inviting Owner.
/// Pending = not used and not revoked (expired ones included): at most one per email (partial unique index).
model AdminInvitation {
  id               String    @id @default(uuid())
  email            String // lowercased
  role             String
  adminRole        AdminRole @relation(fields: [role], references: [name], onDelete: Restrict, onUpdate: Cascade)
  tokenHash        String    @unique @map("token_hash")
  invitedByAdminId String    @map("invited_by_admin_id")
  invitedBy        AdminUser @relation("AdminInvitationInviter", fields: [invitedByAdminId], references: [id], onDelete: Restrict)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  usedAt           DateTime? @map("used_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([email], map: "admin_invitations_pending_email_key", where: raw("used_at IS NULL AND revoked_at IS NULL"))
  @@index([invitedByAdminId])
  @@map("admin_invitations")
}

/// A back-office role (RX-96, PRD 09 F5): a named set of `resource:action` staff permissions. The five
/// built-in roles (owner, operations, finance, support, viewer) are seeded by their migration.
model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  builtIn     Boolean  @default(false) @map("built_in")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  admins      AdminUser[]
  invitations AdminInvitation[]

  @@map("admin_roles")
}

/// A per-case grant (D56): the admin may reveal the personal data of one user until expiresAt.
model AdminPiiGrant {
  id               String    @id @default(uuid())
  adminId          String    @map("admin_id")
  admin            AdminUser @relation("PiiGrantHolder", fields: [adminId], references: [id], onDelete: Cascade)
  subjectUserId    String    @map("subject_user_id")
  reason           String
  grantedByAdminId String    @map("granted_by_admin_id")
  grantedBy        AdminUser @relation("PiiGrantGranter", fields: [grantedByAdminId], references: [id], onDelete: Restrict)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([adminId, subjectUserId, expiresAt])
  @@index([grantedByAdminId])
  @@map("admin_pii_grants")
}

/// One recovery code of an admin, stored as its SHA-256 hash; shown once at enrolment, usable once.
model AdminRecoveryCode {
  id        String    @id @default(uuid())
  adminId   String    @map("admin_id")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([adminId, codeHash])
  @@map("admin_recovery_codes")
}

/// One sign-in of an admin (D54). scope: "enrolment" (TOTP not enrolled yet) | "full". The refresh token
/// is "<id>.<random>"; only its SHA-256 hash is stored. Every rotation moves the old hash to
/// usedRefreshTokenHashes, so a rotated token presented again is recognised and ends the session.
model AdminSession {
  id                     String    @id @default(uuid())
  adminId                String    @map("admin_id")
  admin                  AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  scope                  String
  refreshTokenHash       String    @map("refresh_token_hash")
  usedRefreshTokenHashes String[]  @default([]) @map("used_refresh_token_hashes")
  userAgent              String?   @map("user_agent")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastSeenAt             DateTime  @map("last_seen_at") @db.Timestamptz()
  absoluteExpiresAt      DateTime  @map("absolute_expires_at") @db.Timestamptz()
  lastReauthAt           DateTime? @map("last_reauth_at") @db.Timestamptz()
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz()

  @@index([adminId])
  @@map("admin_sessions")
}

/// An in-app notification for the back office. recipientRole: "owner"; kind: "lockout".
model AdminNotification {
  id             String     @id @default(uuid())
  recipientRole  String     @map("recipient_role")
  kind           String
  subjectAdminId String?    @map("subject_admin_id")
  subjectAdmin   AdminUser? @relation(fields: [subjectAdminId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  readAt         DateTime?  @map("read_at") @db.Timestamptz()

  @@index([subjectAdminId])
  @@map("admin_notifications")
}

// ─── Offer catalog and platform settings (RX-86, docs/credits.md section 9) ─────
// Offers are rows managed in the back office, never code (D46); values come from prisma/offers.seed.json
// (`bun run seed:offers`) until the catalog screens exist (RX-98). SubscriptionPlan, UserSubscription and
// InvitationCode stay as they are: live code (agent.service.ts, the billing and codes repositories) still reads them;
// retiring them is later work. Version rows, purchase snapshots and change records are append-only: a
// trigger refuses every UPDATE and DELETE (migration 20261015150000_offer_catalog).

/// How a package version is paid: once (Starter, Pro: limits unlocked for good, D37) or every month.
enum PackageBilling {
  one_time
  monthly
}

/// The kind of catalog row or setting a CatalogChange is about.
enum CatalogEntity {
  package
  package_version
  top_up_pack
  top_up_pack_version
  enterprise_bundle
  enterprise_bundle_version
  company_contract
  platform_setting
  /// RX-21: a tier's credit rates (tier-rate seed) and a provider price refresh (ai_models row).
  tier_rate
  ai_model
}

/// A package (Starter, Pro, Enterprise). Price, credits and limits live on its versions.
model Package {
  id           String           @id @default(uuid())
  name         String           @unique
  displayOrder Int              @map("display_order")
  active       Boolean
  visible      Boolean
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  versions     PackageVersion[]

  @@map("packages")
}

/// One version of a package's terms. Append-only: a change creates the next version. The current version
/// is the highest versionNumber whose effectiveFrom has passed.
model PackageVersion {
  id                String             @id @default(uuid())
  packageId         String             @map("package_id")
  package           Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  versionNumber     Int                @map("version_number")
  /// The price in US dollar cents (RNX-53, D235); the rupiah amount is derived at purchase from the stored exchange rate.
  priceUsdCents     Int                @map("price_usd_cents")
  creditsGranted    Decimal            @map("credits_granted") @db.Decimal(18, 6)
  billing           PackageBilling
  maxAgents         Int                @map("max_agents")
  maxConnectedTools Int                @map("max_connected_tools")
  apiAccess         Boolean            @map("api_access")
  allowedChannels   String[]           @map("allowed_channels")
  allowedTiers      String[]           @map("allowed_tiers")
  collaborationEnabled Boolean          @default(false) @map("collaboration_enabled")
  effectiveFrom     DateTime           @default(now()) @map("effective_from") @db.Timestamptz()
  createdBy         String             @map("created_by")
  reason            String
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  purchases         PurchaseSnapshot[]
  paymentOrders     PaymentOrder[]

  @@unique([packageId, versionNumber])
  @@map("package_versions")
}

/// A top-up pack, sold only to accounts with a package (D36). Its terms live on its versions.
model TopUpPack {
  id        String             @id @default(uuid())
  name      String             @unique
  active    Boolean
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  versions  TopUpPackVersion[]

  @@map("top_up_packs")
}

/// One version of a top-up pack's terms. Append-only.
model TopUpPackVersion {
  id             String             @id @default(uuid())
  packId         String             @map("pack_id")
  pack           TopUpPack          @relation(fields: [packId], references: [id], onDelete: Restrict)
  versionNumber  Int                @map("version_number")
  creditsGranted Decimal            @map("credits_granted") @db.Decimal(18, 6)
  /// The price in US dollar cents (RNX-53, D235); the rupiah amount is derived at purchase from the stored exchange rate.
  priceUsdCents  Int                @map("price_usd_cents")
  effectiveFrom  DateTime           @default(now()) @map("effective_from") @db.Timestamptz()
  createdBy      String             @map("created_by")
  reason         String
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  purchases      PurchaseSnapshot[]
  paymentOrders  PaymentOrder[]

  @@unique([packId, versionNumber])
  @@map("top_up_pack_versions")
}

/// An Enterprise bundle. Its amounts live on its versions.
model EnterpriseBundle {
  id        String                    @id @default(uuid())
  name      String                    @unique
  active    Boolean
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()
  versions  EnterpriseBundleVersion[]

  @@map("enterprise_bundles")
}

/// One version of an Enterprise bundle. Append-only. The amounts are D1 (open): nullable, no defaults.
model EnterpriseBundleVersion {
  id                   String            @id @default(uuid())
  bundleId             String            @map("bundle_id")
  bundle               EnterpriseBundle  @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  versionNumber        Int               @map("version_number")
  poolCreditsPerPeriod Decimal?          @map("pool_credits_per_period") @db.Decimal(18, 6)
  monthlyPriceUsdCents Int?              @map("monthly_price_usd_cents")
  effectiveFrom        DateTime          @default(now()) @map("effective_from") @db.Timestamptz()
  createdBy            String            @map("created_by")
  reason               String
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  contracts            CompanyContract[]

  @@unique([bundleId, versionNumber])
  @@map("enterprise_bundle_versions")
}

/// An Enterprise company's contract, filled when a proposal is accepted (RX-32, RX-101). companyId has no
/// foreign key until the company account exists. graceDays (D27), capPolicy (D2) and topUpRoles (D18) are
/// open decisions: nullable, no defaults. defaultMemberShareCredits null means the fair share (grant ÷ seats).
model CompanyContract {
  id                        String                  @id @default(uuid())
  companyId                 String                  @map("company_id")
  bundleVersionId           String                  @map("bundle_version_id")
  bundleVersion             EnterpriseBundleVersion @relation(fields: [bundleVersionId], references: [id], onDelete: Restrict)
  seatLimit                 Int                     @map("seat_limit")
  defaultMemberShareCredits Decimal?                @map("default_member_share_credits") @db.Decimal(18, 6)
  allowedTiers              String[]                @map("allowed_tiers")
  graceDays                 Int?                    @map("grace_days")
  whatsappEnabled           Boolean                 @map("whatsapp_enabled")
  capPolicy                 String?                 @map("cap_policy")
  topUpRoles                Json?                   @map("top_up_roles")
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([companyId])
  @@index([bundleVersionId])
  @@map("company_contracts")
}

/// What a buyer bought, copied from the version at the time of purchase (D37: permanent). Exactly one of
/// packageVersionId and topUpPackVersionId is set (CHECK). Append-only. For a top-up pack the limits
/// are null and the lists empty.
model PurchaseSnapshot {
  id                 String            @id @default(uuid())
  buyerUserId        String            @map("buyer_user_id")
  buyer              User              @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  packageVersionId   String?           @map("package_version_id")
  packageVersion     PackageVersion?   @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  topUpPackVersionId String?           @map("top_up_pack_version_id")
  topUpPackVersion   TopUpPackVersion? @relation(fields: [topUpPackVersionId], references: [id], onDelete: Restrict)
  /// The version's price in US dollar cents at the time of purchase (RNX-53).
  priceUsdCents      Int               @map("price_usd_cents")
  /// The USD to IDR rate used for this charge, its own date and its source (RNX-53, D235).
  exchangeRate       Decimal           @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate   DateTime          @map("exchange_rate_date") @db.Date
  exchangeRateSource String            @map("exchange_rate_source")
  /// The rupiah amount charged: priceUsdCents x exchangeRate, rounded up to the rupiah rounding step.
  priceRupiah        Int               @map("price_rupiah")
  creditsGranted     Decimal           @map("credits_granted") @db.Decimal(18, 6)
  billing            PackageBilling?
  maxAgents          Int?              @map("max_agents")
  maxConnectedTools  Int?              @map("max_connected_tools")
  apiAccess          Boolean?          @map("api_access")
  allowedChannels    String[]          @map("allowed_channels")
  allowedTiers       String[]          @map("allowed_tiers")
  collaborationEnabled Boolean?        @map("collaboration_enabled")
  /// The payment it was bought with (RNX-35: the provider reference); unique, so one payment has one snapshot. Null for a code.
  paymentId          String?           @unique @map("payment_id")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  @@index([buyerUserId, createdAt])
  @@index([packageVersionId])
  @@index([topUpPackVersionId])
  @@map("purchase_snapshots")
}

/// One USD to IDR reference rate fetched from a public source (RNX-53, D235): the rupiah price of an offer is its
/// USD price x the latest rate. rateDate is the rate's own date at the source. Insert-only; the unique key makes
/// several instances fetching the same day insert one row, and its prefix serves the latest-rate query.
model ExchangeRate {
  id        String   @id @default(uuid())
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 6)
  rateDate  DateTime @map("rate_date") @db.Date
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz()
  source    String

  @@unique([base, quote, rateDate, source])
  @@map("exchange_rates")
}

// RX-20: the credit ledger (docs/credits.md section 2). Fresh start: no balance, Transaction row or token counter
// is carried over (section 8). Every amount is Decimal(18, 6), whole micro-credits (section 2.3). The CHECK
// constraints, the partial unique index on call_id and the append-only trigger are written by hand in migration
// 20261019120000_credit_ledger (Prisma does not model them).

/// One balance of an account (docs/credits.md Terms): a user has `paid` and `weekly_free`, a company only `paid`.
enum CreditWallet {
  paid
  weekly_free
}

/// What caused a ledger entry (docs/credits.md section 2.1).
enum CreditEntryType {
  plan_grant
  top_up
  bonus
  weekly_reset
  usage
  refund
  adjustment
}

/// How a model call ended; on `usage` entries only.
enum CreditCallOutcome {
  completed
  provider_error
  client_cancel
}

/// The state of a reservation (docs/credits.md section 3.1).
enum CreditReservationStatus {
  open
  settled
  released
  expired
}

/// One wallet of one account; the balance is read from this row, never by summing entries (I1, I2).
/// Exactly one of userId and companyId is set (CHECK). companyId has no foreign key: there is no company
/// table yet (see CompanyContract). balance >= 0, held >= 0 and held <= balance (CHECK, I5). frozen is
/// used on a company pool only (D23).
model CreditAccount {
  id           String              @id @default(uuid())
  userId       String?             @map("user_id")
  user         User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  companyId    String?             @map("company_id")
  wallet       CreditWallet
  balance      Decimal             @default(0) @db.Decimal(18, 6)
  held         Decimal             @default(0) @db.Decimal(18, 6)
  frozen       Boolean             @default(false)
  lastSeq      Int                 @default(0) @map("last_seq")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  entries      CreditLedgerEntry[]
  reservations CreditReservation[]

  @@unique([userId, wallet])
  @@unique([companyId, wallet])
  /// The target of the entries' and reservations' (accountId, wallet) foreign keys: a row's wallet is its account's wallet.
  @@unique([id, wallet])
  @@map("credit_accounts")
}

/// One ledger entry. Append-only: a trigger refuses every UPDATE and DELETE (I7). seq is 1, 2, 3, ... per
/// account with no gaps; balanceAfter is the account's balance right after this entry (I2). The usage fields
/// are set on `usage` entries only, and requestId, callId, the model, rates, tokens and outcome are required
/// there (CHECK); callId is unique among `usage` entries (partial unique index, I3). reference is required
/// on every type except `usage` and `weekly_reset` (CHECK). memberUserId has no foreign key: on an
/// adjustment it is the admin's id. modelId is the model's slug, with no foreign key.
model CreditLedgerEntry {
  id             String             @id @default(uuid())
  accountId      String             @map("account_id")
  account        CreditAccount      @relation(fields: [accountId, wallet], references: [id, wallet], onDelete: Restrict)
  wallet         CreditWallet
  seq            Int
  type           CreditEntryType
  amount         Decimal            @db.Decimal(18, 6)
  balanceAfter   Decimal            @map("balance_after") @db.Decimal(18, 6)
  uncharged      Decimal            @default(0) @db.Decimal(18, 6)
  memberUserId   String             @map("member_user_id")
  requestId      String?            @map("request_id")
  callId         String?            @map("call_id")
  runId          String?            @map("run_id")
  agentId        String?            @map("agent_id")
  parentCallId   String?            @map("parent_call_id")
  modelId        String?            @map("model_id")
  tier           String?
  rateNew        Decimal?           @map("rate_new") @db.Decimal(18, 12)
  rateCached     Decimal?           @map("rate_cached") @db.Decimal(18, 12)
  rateOut        Decimal?           @map("rate_out") @db.Decimal(18, 12)
  tokensNew      Int?               @map("tokens_new")
  tokensCached   Int?               @map("tokens_cached")
  tokensOut      Int?               @map("tokens_out")
  outcome        CreditCallOutcome?
  reference      String?
  idempotencyKey String             @map("idempotency_key")
  /// RNX-232: the API key the call was made with (ledger attribution, the key's monthly cap); null otherwise.
  apiKeyId       String?            @map("api_key_id")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([accountId, seq])
  @@unique([accountId, idempotencyKey])
  /// I3: a call_id appears on at most one usage entry (partial unique index, created by the migration).
  @@unique([callId], map: "credit_ledger_entries_usage_call_id_key", where: raw("type = 'usage'"))
  /// RNX-228: credits sold per day reads the purchase entries (top_up, plan_grant) of a day. Written as Postgres prints
  /// the predicate, so `migrate diff` sees no drift.
  @@index([createdAt], map: "credit_ledger_entries_purchase_created_at_idx", where: raw("type = ANY (ARRAY['top_up'::\"CreditEntryType\", 'plan_grant'::\"CreditEntryType\"])"))
  @@index([apiKeyId, createdAt])
  @@map("credit_ledger_entries")
}

/// A hold on an account for one request or run (docs/credits.md section 3; not a ledger entry). The sweep reads
/// expired open reservations through the (status, expiresAt) index. 0 <= consumed <= amountHeld (CHECK, I4).
/// Table only: reserve, settle, release and the sweep are RX-22.
model CreditReservation {
  id         String                  @id @default(uuid())
  accountId  String                  @map("account_id")
  account    CreditAccount           @relation(fields: [accountId, wallet], references: [id, wallet], onDelete: Restrict)
  wallet     CreditWallet
  requestId  String                  @map("request_id")
  runId      String?                 @map("run_id")
  /// RNX-232: the API key of the request (its open holds count against the key's monthly cap); null otherwise.
  apiKeyId   String?                 @map("api_key_id")
  amountHeld Decimal                 @map("amount_held") @db.Decimal(18, 6)
  consumed   Decimal                 @default(0) @db.Decimal(18, 6)
  status     CreditReservationStatus @default(open)
  expiresAt  DateTime                @map("expires_at") @db.Timestamptz()
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, expiresAt])
  @@index([apiKeyId, status])
  @@map("credit_reservations")
}

/// One platform setting. name is a key of the registry in apps/api/src/app/offers/config/platform-settings.ts,
/// whose Zod schema validates value on every write. A setting without a row is not set.
model PlatformSetting {
  name      String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("platform_settings")
}

/// One change to a catalog row or a platform setting: who (an admin id or an operator label such as
/// "seed:<name>"), why, when it takes effect, and the values before (null on create) and after. Append-only.
model CatalogChange {
  id            String        @id @default(uuid())
  entity        CatalogEntity
  entityId      String        @map("entity_id")
  changedBy     String        @map("changed_by")
  reason        String
  before        Json?
  after         Json
  effectiveFrom DateTime      @default(now()) @map("effective_from") @db.Timestamptz()
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entity, entityId, createdAt])
  @@map("catalog_changes")
}

/// One back-office write or personal-data reveal (RX-97, D57, D61): who (adminId), what (resource,
/// action), the values before and after (non-secret state only: never tokens, TOTP secrets, recovery
/// codes, password hashes or personal data), the reason the admin typed ("" when the route asks for
/// none), the request id, and when the change takes effect. Append-only, enforced in the database: the
/// trigger "admin_audit_log_append_only" (migration 20261015120000_admin_audit_log) refuses every UPDATE
/// and DELETE. Kept at least two years; nothing deletes rows. onDelete Restrict: an admin who has audit
/// rows cannot be deleted, so deleting an admin can never rewrite or orphan them.
model AdminAuditLog {
  id          String    @id @default(uuid())
  adminId     String    @map("admin_id")
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resource    String
  action      String
  before      Json
  after       Json
  reason      String
  requestId   String    @map("request_id")
  effectiveAt DateTime  @map("effective_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([adminId, createdAt])
  @@index([resource, createdAt])
  /// RX-164: the audit log screen reads newest first by (created_at, id); filtered by action too.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([action, createdAt])
  @@map("admin_audit_log")
}

/// RNX-162 (D243 decision 38, D235): what one model call cost us, one row per call_id, 1:1 with the call's usage entry
/// (credit_ledger_entries, which stays as it is). Written after the usage entry commits, outside its transaction: a
/// failed write is logged and never fails the call. No prompt or answer content. USD amounts are Decimal; the rupiah
/// amounts and the rate are null when no usable USD to IDR rate is stored (none, or older than 7 days).
model ModelCallCost {
  id               String       @id @default(uuid())
  callId           String       @unique @map("call_id")
  /// The provider record that served the call; null on a connection without one (LLM_PROVIDER=fake).
  providerId       String?      @map("provider_id")
  /// The model id sent to the provider (the served model's slug, D149 option B).
  providerModelId  String       @map("provider_model_id")
  tokensNew        Int          @map("tokens_new")
  tokensCached     Int          @map("tokens_cached")
  tokensOut        Int          @map("tokens_out")
  /// Part of tokensOut, as reported; null when the provider reported none.
  tokensReasoning  Int?         @map("tokens_reasoning")
  /// The cost the provider reported for the call (OpenRouter `usage.cost`); null when it reported none.
  reportedCostUsd  Decimal?     @map("reported_cost_usd") @db.Decimal(18, 12)
  /// new x input + cached x cached input + output x output price; null when the model's prices were not known.
  tokenPriceUsd    Decimal?     @map("token_price_usd") @db.Decimal(18, 12)
  /// Null only when there is neither a reported cost nor a token-price figure.
  costLowUsd       Decimal?     @map("cost_low_usd") @db.Decimal(18, 12)
  costHighUsd      Decimal?     @map("cost_high_usd") @db.Decimal(18, 12)
  costLowIdr       Decimal?     @map("cost_low_idr") @db.Decimal(24, 12)
  costHighIdr      Decimal?     @map("cost_high_idr") @db.Decimal(24, 12)
  exchangeRate     Decimal?     @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate DateTime?    @map("exchange_rate_date") @db.Date
  wallet           CreditWallet
  /// The workspace of the agent run that made the call; null on a path without one (chat, portal).
  workspaceId      String?      @map("workspace_id")
  tier             String
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  /// RNX-228's reconciliation reads the calls of one day.
  @@index([createdAt])
  @@map("model_call_costs")
}

// RNX-228: daily usage, cost and revenue aggregates. A closed Asia/Jakarta day is built once by the rollup job
// (UsageRollupScheduler) into usage_daily_rollups and credit_sales_daily_rollups, and recorded in usage_rollup_days;
// a day without a usage_rollup_days row (today, or a day the job has not built yet) is computed live from the raw
// rows with the same query. Written by raw SQL in UsageRollupRepository only.

/// One built day of the usage and credit-sales rollups (RNX-228). Its rows are complete: the day is not built again.
model UsageRollupDay {
  day     DateTime @id @db.Date
  builtAt DateTime @default(now()) @map("built_at") @db.Timestamptz()

  @@map("usage_rollup_days")
}

/// The model calls of one Asia/Jakarta day per provider, model, tier, wallet, workspace or user, and package (RNX-228).
model UsageDailyRollup {
  id                    String       @id @default(uuid())
  day                   DateTime     @db.Date
  /// Null: calls without a provider record ("no provider record").
  providerId            String?      @map("provider_id")
  providerModelId       String       @map("provider_model_id")
  tier                  String
  wallet                CreditWallet
  /// The call's workspace (agent runs); null on a path without one.
  workspaceId           String?      @map("workspace_id")
  /// The usage entry's memberUserId (the runner) when the call has no workspace; null otherwise.
  userId                String?      @map("user_id")
  /// The purchase snapshot the call's credits are priced from (paid wallet only); null without one.
  packageVersionId      String?      @map("package_version_id")
  topUpPackVersionId    String?      @map("top_up_pack_version_id")
  calls                 Int
  tokensNew             BigInt       @map("tokens_new")
  tokensCached          BigInt       @map("tokens_cached")
  tokensOut             BigInt       @map("tokens_out")
  tokensReasoning       BigInt       @map("tokens_reasoning")
  /// Sums over the calls whose USD cost is known; costUnknownUsdCalls counts the others.
  costLowUsd            Decimal      @map("cost_low_usd") @db.Decimal(30, 12)
  costHighUsd           Decimal      @map("cost_high_usd") @db.Decimal(30, 12)
  costUnknownUsdCalls   Int          @map("cost_unknown_usd_calls")
  /// Sums over the calls whose rupiah cost is known; costUnknownIdrCalls counts the others.
  costLowIdr            Decimal      @map("cost_low_idr") @db.Decimal(36, 12)
  costHighIdr           Decimal      @map("cost_high_idr") @db.Decimal(36, 12)
  costUnknownIdrCalls   Int          @map("cost_unknown_idr_calls")
  /// Credits charged on paid-wallet calls (minus the usage entries' amounts).
  creditsConsumed       Decimal      @map("credits_consumed") @db.Decimal(30, 6)
  /// Credits consumed x the snapshot's price per credit, over the calls priced from a snapshot.
  revenueIdr            Decimal      @map("revenue_idr") @db.Decimal(36, 12)
  revenueUsd            Decimal      @map("revenue_usd") @db.Decimal(30, 12)
  /// Paid-wallet calls with no snapshot to price them (no usage entry, a company pool, credits from a code).
  revenueUnknownCalls   Int          @map("revenue_unknown_calls")
  revenueUnknownCredits Decimal      @map("revenue_unknown_credits") @db.Decimal(30, 6)

  @@index([day])
  @@map("usage_daily_rollups")
}

/// Credits sold on one Asia/Jakarta day per package (RNX-228): paid-wallet top_up and plan_grant entries whose reference
/// is a purchase snapshot's payment id. The value is the snapshot's list price, not cash received.
model CreditSalesDailyRollup {
  id                 String   @id @default(uuid())
  day                DateTime @db.Date
  packageVersionId   String?  @map("package_version_id")
  topUpPackVersionId String?  @map("top_up_pack_version_id")
  entries            Int
  creditsSold        Decimal  @map("credits_sold") @db.Decimal(30, 6)
  listValueIdr       Decimal  @map("list_value_idr") @db.Decimal(30, 0)
  listValueUsd       Decimal  @map("list_value_usd") @db.Decimal(30, 2)

  @@index([day])
  @@map("credit_sales_daily_rollups")
}

/// A provider record's portal balance on one Asia/Jakarta day, entered by an admin (RNX-228). One per provider and day.
model ProviderReconciliationEntry {
  id               String   @id @default(uuid())
  providerId       String   @map("provider_id")
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  day              DateTime @db.Date
  portalBalanceUsd Decimal  @map("portal_balance_usd") @db.Decimal(18, 6)
  /// Credit bought on the portal that day, in USD; 0 when none.
  topUpUsd         Decimal  @map("top_up_usd") @db.Decimal(18, 6)
  enteredByAdminId String   @map("entered_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([providerId, day])
  @@map("provider_reconciliation_entries")
}

// RNX-35a (D240, docs/payments.md): orders paid through one payment provider (PaymentProvider; only the fake exists in
// 35a). A webhook never grants: the grant follows a status check that answers paid with the order's exact amount. The
// CHECK on the offer columns is written by hand in migration 20261022060000_payment_orders.

/// The life of a payment order (docs/payments.md section 2).
enum PaymentOrderStatus {
  pending
  paid
  expired
  cancelled
  failed
}

/// Why a payment the provider reported could not be applied to an order.
enum PaymentUnmatchedReason {
  /// No order has the reported reference.
  unknown_reference
  /// The order's status check answered paid with another amount.
  amount_mismatch
}

/// Whether staff have settled an unmatched payment (refunded outside the API, docs/payments.md section 5).
enum PaymentUnmatchedStatus {
  open
  refunded
}

/// One checkout: the buyer, the offer version and its price as quoted at checkout (USD price x the purchase rate, the
/// same columns as the purchase snapshot), the provider and its reference, and the status with its flags. Exactly one
/// of packageVersionId and topUpPackVersionId is set (CHECK). The (provider, providerRef) pair is unique: the webhook
/// and the status check find the order by it. reconcileClaimedUntil is the reconciliation job's claim on the row.
model PaymentOrder {
  id                    String             @id @default(uuid())
  userId                String             @map("user_id")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  packageVersionId      String?            @map("package_version_id")
  packageVersion        PackageVersion?    @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  topUpPackVersionId    String?            @map("top_up_pack_version_id")
  topUpPackVersion      TopUpPackVersion?  @relation(fields: [topUpPackVersionId], references: [id], onDelete: Restrict)
  priceUsdCents         Int                @map("price_usd_cents")
  exchangeRate          Decimal            @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate      DateTime           @map("exchange_rate_date") @db.Date
  exchangeRateSource    String             @map("exchange_rate_source")
  /// The rupiah amount to pay; a status check must report exactly this amount before anything is granted.
  amountRupiah          Int                @map("amount_rupiah")
  provider              String
  /// The provider's own reference (its transaction id); null until the charge is created.
  providerRef           String?            @map("provider_ref")
  /// What the buyer pays with: a QR string or a URL, as the provider returned it.
  paymentCode           String?            @map("payment_code")
  status                PaymentOrderStatus @default(pending)
  expiresAt             DateTime           @map("expires_at") @db.Timestamptz()
  paidAt                DateTime?          @map("paid_at") @db.Timestamptz()
  lastWebhookAt         DateTime?          @map("last_webhook_at") @db.Timestamptz()
  isLate                Boolean            @default(false) @map("is_late")
  isAmountMismatch      Boolean            @default(false) @map("is_amount_mismatch")
  isUnconfirmed         Boolean            @default(false) @map("is_unconfirmed")
  isWebhookMissed       Boolean            @default(false) @map("is_webhook_missed")
  /// Status checks that answered neither paid, expired nor cancelled; at 3 the order needs manual review.
  unknownChecks         Int                @default(0) @map("unknown_checks")
  needsReview           Boolean            @default(false) @map("needs_review")
  reconcileClaimedUntil DateTime?          @map("reconcile_claimed_until") @db.Timestamptz()
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  changes               PaymentOrderChange[]

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("payment_orders")
}

/// The audit of a payment order: one row per status change or flag (who or what made it, and why).
model PaymentOrderChange {
  id         String              @id @default(uuid())
  orderId    String              @map("order_id")
  order      PaymentOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// What happened: created, charge_failed, paid, expired, cancelled, amount_mismatch, unconfirmed, unknown_status, needs_review.
  event      String
  fromStatus PaymentOrderStatus? @map("from_status")
  toStatus   PaymentOrderStatus  @map("to_status")
  /// checkout, webhook, reconcile or admin.
  source     String
  /// The admin's id when source is admin.
  actorId    String?             @map("actor_id")
  note       String?
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  @@index([orderId, createdAt])
  @@map("payment_order_changes")
}

/// One verified provider webhook, as received: the reported reference, status and amount, and the SHA-256 of the raw
/// body (the body itself is not kept). orderId is null when no order has the reference (see PaymentUnmatchedPayment).
model PaymentWebhookEvent {
  id                   String   @id @default(uuid())
  provider             String
  providerRef          String   @map("provider_ref")
  orderId              String?  @map("order_id")
  reportedStatus       String   @map("reported_status")
  reportedAmountRupiah Int?     @map("reported_amount_rupiah")
  bodySha256           String   @map("body_sha256")
  receivedAt           DateTime @default(now()) @map("received_at") @db.Timestamptz()

  @@index([provider, providerRef])
  @@index([receivedAt])
  @@map("payment_webhook_events")
}

/// A payment the provider reported that grants nothing: its reference matches no order, or the amount did not match
/// the order's. Staff refund it outside the API and mark it refunded with a note (docs/payments.md section 5).
model PaymentUnmatchedPayment {
  id           String                 @id @default(uuid())
  provider     String
  providerRef  String                 @map("provider_ref")
  reason       PaymentUnmatchedReason
  orderId      String?                @map("order_id")
  amountRupiah Int?                   @map("amount_rupiah")
  status       PaymentUnmatchedStatus @default(open)
  refundedAt   DateTime?              @map("refunded_at") @db.Timestamptz()
  refundedBy   String?                @map("refunded_by")
  refundNote   String?                @map("refund_note")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([provider, providerRef])
  @@index([createdAt])
  @@map("payment_unmatched_payments")
}
