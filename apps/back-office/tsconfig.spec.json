{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "composite": false,
    "declarationMap": false,
    "incremental": false,
    "rootDir": ".",
    "outDir": "../../dist/out-tsc",
    "tsBuildInfoFile": null,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.d.ts", "index.d.ts"],
  "exclude": []
}
