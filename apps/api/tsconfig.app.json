{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node"
    ],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "paths": {
      "@generated/prisma/*": ["./src/generated/prisma/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": ["src/**/*.spec.ts"]
}
