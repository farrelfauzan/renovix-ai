// Specs and apps/api/test: type-checked with `tsc --noEmit -p apps/api/tsconfig.spec.json`, compiled by ts-jest.
// CommonJS for Jest; "bundler" is the resolution TypeScript 6 accepts with it (keeps the path alias and ".js" imports).
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "composite": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts", "test/**/*.ts"],
  "exclude": []
}
